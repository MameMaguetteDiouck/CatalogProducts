APP_NAME=CatalogProducts
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# NoSQL Database (MongoDB)
DB_CONNECTION=mongodb
# Exécution dans le conteneur Docker (service mongodb) :
MONGODB_URI=mongodb://catalog_user:catalog_secret@mongodb:27017/catalog_db?authSource=catalog_db
# Exécution sur machine hôte (si base lancée via docker-compose.db.yml) :
# MONGODB_URI=mongodb://catalog_user:catalog_secret@localhost:27017/catalog_db?authSource=catalog_db
MONGODB_DATABASE=catalog_db

# Pilotes locaux (Fichiers)
SESSION_DRIVER=file
CACHE_STORE=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

# E-mail (Par défaut 'log' pour intercepter les mails en local ; passer à 'smtp' si renseigné)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Frontend (Vite)
VITE_APP_NAME="${APP_NAME}"
