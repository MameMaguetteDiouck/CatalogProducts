APP_NAME=CatalogPro
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Base de données NoSQL (MongoDB 7)
DB_CONNECTION=mongodb
# Exécution sur machine hôte (base lancée via docker compose -f docker-compose.db.yml up -d) :
MONGODB_URI=mongodb://catalog_user:catalog_secret@127.0.0.1:27017/catalog_db?authSource=catalog_db
# Exécution dans le conteneur applicatif Docker (réseau docker-compose.yml) :
# MONGODB_URI=mongodb://catalog_user:catalog_secret@mongodb:27017/catalog_db?authSource=catalog_db
MONGODB_DATABASE=catalog_db

# Pilotes de session & stockage local
SESSION_DRIVER=file
CACHE_STORE=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

# Authentification & Sécurité JWT (Jeton HttpOnly sécurisé)
JWT_TTL_MINUTES=480

# E-mail (Aucun serveur SMTP requis : les réinitialisations de mot de passe sont assurées par l'administrateur)
MAIL_MAILER=log

# Frontend (Vite)
VITE_APP_NAME="${APP_NAME}"

# Compte administrateur initial (initialisé lors du seeding)
DEFAULT_ADMIN_NAME="Directeur Général"
DEFAULT_ADMIN_EMAIL=admin@catalog.local
DEFAULT_ADMIN_PASSWORD=Password123!

