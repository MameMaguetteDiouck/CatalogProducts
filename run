#!/bin/sh
# Helper script to execute commands inside the catalog_app container

if [ "$#" -eq 0 ]; then
    echo "Usage: ./run [artisan|composer|npm|test|bash] [arguments...]"
    exit 1
fi

CMD="$1"
shift

case "$CMD" in
    artisan)
        docker compose exec app php artisan "$@"
        ;;
    composer)
        docker compose exec app composer "$@"
        ;;
    npm)
        docker compose exec app npm "$@"
        ;;
    test)
        docker compose exec app php artisan test "$@"
        ;;
    bash|sh)
        docker compose exec app sh
        ;;
    *)
        docker compose exec app "$CMD" "$@"
        ;;
esac
